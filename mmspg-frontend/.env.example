# ==============================================================================
# MMSPG Frontend (React + Vite) Environment Configuration
# ==============================================================================
# NOTE: In Vite, all client-exposed environment variables must start with 'VITE_'.
# They are embedded into the client bundles at build time (e.g. 'npm run build').
# For production or test deployments, set this variable before building.

# MMSPG Backend API Base URL (Protocol + Host + Port)
# Local: http://localhost:8004
# Test / Staging Server: http://<backend-server-ip>:8004 or https://api.mmspg.yourdomain.com
VITE_API_BASE_URL=http://localhost:8004

